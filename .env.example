# ==============================================================================
# CHRONOS CORE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Required for coordinator persistence and Flyway migrations
CHRONOS_DB_NAME=chronos_core
CHRONOS_DB_USERNAME=chronos_user
# Change this in production! Must be strong random string:
CHRONOS_DB_PASSWORD=chronos_dev_pass
CHRONOS_DB_HOST=postgres
CHRONOS_DB_PORT=5432
CHRONOS_DB_URL=jdbc:postgresql://postgres:5432/chronos_core
CHRONOS_DB_POOL_MAX=20
CHRONOS_DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED COORDINATION & CACHE (Redis)
# ------------------------------------------------------------------------------
# Required for lease-based leader election, distributed locks, rate limiters
CHRONOS_REDIS_HOST=redis
CHRONOS_REDIS_PORT=6379
CHRONOS_REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Minimum 256-bit (32 bytes) secure random key
CHRONOS_JWT_SECRET=chronos-core-distributed-orchestration-dev-secret-key-32bytes-minimum
CHRONOS_JWT_ISSUER=chronos-core
CHRONOS_JWT_VALIDITY=3600

# ------------------------------------------------------------------------------
# 4. COORDINATOR CONFIGURATION
# ------------------------------------------------------------------------------
CHRONOS_COORDINATOR_PORT=8080
CHRONOS_COORDINATOR_GRPC_PORT=9090
CHRONOS_COORDINATOR_ID=coordinator-node-1
CHRONOS_LEADER_LEASE_DURATION=5s
CHRONOS_LEADER_RENEWAL_INTERVAL=1500ms
CHRONOS_TASK_LOCK_TTL=30s
CHRONOS_LEASE_DURATION=30s
CHRONOS_LEASE_RENEWAL_INTERVAL=10s
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 5. WORKER FLEET CONFIGURATION
# ------------------------------------------------------------------------------
CHRONOS_WORKER_ENABLED=true
CHRONOS_WORKER_MAX_CONCURRENCY=8
CHRONOS_WORKER_HEARTBEAT_INTERVAL=1000ms
CHRONOS_WORKER_HEARTBEAT_TIMEOUT=3s
CHRONOS_WORKER_EVICTION_TIMEOUT=6s

# ------------------------------------------------------------------------------
# 6. OPTIONAL AI SUBSYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
# Set to true only if enabling AI Workflow and Operations agents
CHRONOS_AI_ENABLED=false
# Supported providers: STUB, OPENAI, ANTHROPIC, GEMINI
CHRONOS_AI_PROVIDER=STUB
CHRONOS_AI_API_KEY=
CHRONOS_AI_ENDPOINT=
CHRONOS_AI_MODEL=

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & CONTROL PLANE EXPOSURE
# ------------------------------------------------------------------------------
CHRONOS_DASHBOARD_PORT=5173
CHRONOS_PROMETHEUS_PORT=9095
CHRONOS_GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=chronos_admin
