# ==============================================================================
# Chronos Core - Git Ignore Rules
# ==============================================================================

# Compiled Java / Maven artifacts
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node.js / Frontend dependencies & build outputs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
*.local
.vite/
.turbo/
*.tsbuildinfo

# Environment files & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.pkcs12
*.p12
*.jks

# Logs
logs/
*.log
*.log.*

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse
.project
.classpath
.settings/
bin/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Antigravity / Agent runtime artifacts
.gemini/
.system_generated/
