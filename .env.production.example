# ==============================================================================
# CHRONOS CORE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
#
# INSTRUCTIONS:
# 1. Copy this template to .env.production on your deployment target:
#      cp .env.production.example .env.production
# 2. Generate strong, cryptographically secure values for all required secrets.
# 3. Restrict file permissions:
#      chmod 600 .env.production
# 4. NEVER commit .env.production or any secret values to Git or source control.
# 5. Launch stack:
#      docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
CHRONOS_DB_NAME=chronos_core
CHRONOS_DB_USERNAME=chronos_user

# REQUIRED: Generate high-entropy database password:
#   Example generator: openssl rand -base64 24
CHRONOS_DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# Database Connection & SSL
# Default sslmode is "require" for production transport encryption.
# Supported options: require, verify-ca, verify-full
CHRONOS_DB_SSL_MODE=require
CHRONOS_DB_POOL_MAX=20
CHRONOS_DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED COORDINATION & CACHE (Redis 7.2)
# ------------------------------------------------------------------------------
# OPTIONAL AUTH: If Redis AUTH is enabled, supply a strong random password.
# Leave blank only if Redis is isolated on a private airgapped subnet without external ingress.
CHRONOS_REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT & RBAC)
# ------------------------------------------------------------------------------
# REQUIRED: Cryptographically secure 256-bit (32 bytes minimum) HMAC-SHA256 signing key.
# Generate on Linux/macOS/Git-Bash:
#   openssl rand -hex 32
CHRONOS_JWT_SECRET=REPLACE_WITH_GENERATED_256BIT_HEX_SECRET

CHRONOS_JWT_ISSUER=chronos-core
CHRONOS_JWT_VALIDITY=3600

# Development Auth Controller is strictly disabled in production:
CHRONOS_DEV_AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# 4. CORS & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Set to the exact HTTPS origin of the production control plane dashboard.
# Multiple comma-separated origins are supported.
# NEVER use wildcard (*) when credentials/cookies are enabled.
# Example: https://chronos.yourcompany.com
CHRONOS_CORS_ALLOWED_ORIGINS=https://chronos.yourcompany.com

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & METRICS
# ------------------------------------------------------------------------------
# Web Dashboard external port (defaults to standard HTTP 80):
CHRONOS_DASHBOARD_PORT=80

# Grafana Admin Credentials:
GRAFANA_ADMIN_USER=admin
# REQUIRED: Strong administrative password for Grafana operator dashboards:
#   Example generator: openssl rand -base64 20
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# Grafana loopback bind address (keeps Grafana protected from public internet):
# Defaults to 127.0.0.1. Access via SSH tunnel or VPN: ssh -L 3000:127.0.0.1:3000 operator@host
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000

# ------------------------------------------------------------------------------
# 6. WORKER FLEET CONCURRENCY
# ------------------------------------------------------------------------------
CHRONOS_WORKER_MAX_CONCURRENCY=8

# ------------------------------------------------------------------------------
# 7. OPTIONAL AI SUBSYSTEM
# ------------------------------------------------------------------------------
# Production defaults to offline STUB provider without external API calls.
CHRONOS_AI_ENABLED=false
CHRONOS_AI_PROVIDER=stub
# If enabling external LLM (e.g., OPENAI, ANTHROPIC), set API key securely:
CHRONOS_AI_API_KEY=
CHRONOS_AI_ENDPOINT=
CHRONOS_AI_MODEL=
